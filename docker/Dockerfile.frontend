# Frontend Dockerfile for Yoga Sutras React App
# Stage 1: Build the React application
FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/ .

# API base URL baked into the bundle at build time. Defaults to same-origin
# '/api' so visitors never hit their own localhost. In k8s the ingress routes
# /api -> backend; in docker-compose nginx proxies /api -> backend (nginx.conf).
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# nginx's entrypoint runs envsubst over /etc/nginx/templates/*.template into
# /etc/nginx/conf.d/ at container start. The /api proxy target has to differ
# per environment: docker-compose resolves the service name "backend", while
# Kubernetes has no such host (its ingress routes /api straight to the backend
# Service). A baked-in "backend" made nginx exit at boot in-cluster with
# "host not found in upstream".
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV BACKEND_UPSTREAM=backend:5001

# Copy built assets from build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
